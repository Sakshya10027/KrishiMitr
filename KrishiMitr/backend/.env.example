# KrishiMitr Backend Environment Configuration
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/krishimitr?schema=public
FRONTEND_URL=http://localhost:5173

# Authentication Secrets (Replace in production with 64+ char random keys)
JWT_ACCESS_SECRET=krishimitr_development_jwt_access_secret_super_secure_key_10283
JWT_REFRESH_SECRET=krishimitr_development_jwt_refresh_secret_super_secure_key_84920
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20

# Bharti AI Assistant Provider Configuration
# Supported providers: fallback | gemini | anthropic | openai
AI_PROVIDER=fallback
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=

# Storage Provider: local | s3
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Seed Initial Administrator (Created on first seed run)
SEED_ADMIN_EMAIL=admin@soilhealth.gov.in
SEED_ADMIN_PASSWORD=KrishiMitr@Admin2026!
SEED_ADMIN_NAME=National Portal Nodal Administrator
